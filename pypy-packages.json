  "query": "SELECT project, count() AS downloads\nFROM pypi.pypi\nPREWHERE project IN (\n    SELECT DISTINCT replaceRegexpAll(lower(name), '[-_.]+', '-')\n    FROM pypi.projects WHERE match(arrayElement(splitByChar('-', filename), -3), '(^|[.])pp[0-9]+([.]|$)') AND endsWith(filename,'.whl')\n) AND date >= '2026-10-26' AND date < '2026-11-25'\nWHERE match(arrayElement(splitByChar('-', filename), -3), '(^|[.])pp[0-9]+([.]|$)') AND endsWith(filename,'.whl')\nGROUP BY project\nORDER BY downloads DESC, project\nLIMIT 50 FORMAT JSONEachRow",
